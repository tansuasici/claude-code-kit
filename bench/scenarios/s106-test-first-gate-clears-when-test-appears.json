{
  "name": "s106-test-first-gate-clears-when-test-appears",
  "setup_files": {
    "package.json": "{\"name\": \"demo\"}\n",
    "src/calc.ts": "export function add(a, b) {\n  return a + b;\n}\n"
  },
  "env": {
    "CCK_TEST_FIRST": "strict"
  },
  "steps": [
    {
      "hook": ".claude/hooks/test-first.sh",
      "payload": {
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "{TMPROOT}/src/calc.ts"
        },
        "session_id": "sess-a"
      },
      "expect": {
        "exit_code": 0,
        "file_contains": [
          {
            "file": ".hook-state/test-first-pending.tsv",
            "substr": "calc.ts"
          }
        ]
      }
    },
    {
      "setup_files": {
        "src/calc.test.ts": "test('adds', () => {});\n"
      },
      "hook": ".claude/hooks/test-first-gate.sh",
      "payload": {
        "session_id": "sess-a",
        "cwd": "{TMPROOT}"
      },
      "expect": {
        "exit_code": 0
      }
    }
  ],
  "notes": "TAN-7038. The gate re-checks the disk instead of trusting the pending list: a test file that appeared without an Edit \u2014 Bash, a generator, a merge \u2014 satisfies the record. stop-gate.sh re-verifies stale files for the same reason (s55)."
}
