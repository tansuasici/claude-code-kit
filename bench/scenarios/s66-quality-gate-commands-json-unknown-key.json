{
  "name": "s66-quality-gate-commands-json-unknown-key",
  "setup_files": {
    ".claude/commands.json": "{\"typcheck\": \"true\"}",
    "src/x.py": "x = 1\n"
  },
  "steps": [
    {
      "hook": ".claude/hooks/quality-gate.sh",
      "payload": { "tool_name": "Edit", "tool_input": { "file_path": "{TMPROOT}/src/x.py" } },
      "expect": {
        "exit_code": 0,
        "stdout_contains": ["unknown key", "typcheck"],
        "state": [{ "file": ".hook-state/last_quality_gate.json", "field": "status", "equals": "error" }]
      }
    },
    {
      "hook": ".claude/hooks/stop-gate.sh",
      "payload": {},
      "expect": { "exit_code": 2, "stderr_contains": ["BLOCKED", "typcheck"] }
    }
  ],
  "notes": "A mistyped key used to be ignored: the declared check never ran and the gate guessed another one. It is now a config error that names the key and blocks."
}
