{
  "name": "s90-session-start-keeps-other-sessions-failures",
  "steps": [
    {
      "hook": ".claude/hooks/quality-gate.sh",
      "setup_files": {
        "src/a.py": "def x(:\n"
      },
      "payload": {
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "{TMPROOT}/src/a.py"
        },
        "session_id": "A"
      },
      "expect": {
        "exit_code": 0
      }
    },
    {
      "hook": ".claude/hooks/session-start.sh",
      "payload": {
        "source": "startup",
        "session_id": "B"
      },
      "expect": {
        "exit_code": 0,
        "file_grew": [
          ".hook-state/quality-gate-state.json"
        ]
      }
    },
    {
      "hook": ".claude/hooks/stop-gate.sh",
      "payload": {
        "session_id": "B"
      },
      "expect": {
        "exit_code": 0
      }
    },
    {
      "hook": ".claude/hooks/stop-gate.sh",
      "payload": {
        "session_id": "A"
      },
      "expect": {
        "exit_code": 2,
        "stderr_contains": [
          "BLOCKED",
          "src/a.py"
        ]
      }
    }
  ],
  "notes": "Two sessions in one project. B's SessionStart used to delete the gate state, wiping A's failure. Results now carry their session_id and are kept: B's stop isn't blocked by A's file, A's still is."
}
