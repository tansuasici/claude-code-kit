{
  "name": "s131-commit-gate-blocks-failed-check-strict",
  "setup_files": {
    "package.json": "{\"name\": \"demo\"}\n"
  },
  "steps": [
    {
      "hook": ".claude/hooks/quality-gate.sh",
      "setup_files": {
        "src/a.py": "def hello(\n    return 1\n"
      },
      "payload": {
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "{TMPROOT}/src/a.py"
        },
        "session_id": "A"
      },
      "expect": {
        "exit_code": 0
      }
    },
    {
      "hook": ".claude/hooks/commit-gate.sh",
      "payload": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "git commit -m \"feat: add adder\""
        },
        "session_id": "A"
      },
      "env": {
        "CCK_TEST_FIRST": "strict"
      },
      "expect": {
        "exit_code": 2,
        "stderr_contains": [
          "BLOCKED",
          "src/a.py",
          "SKIP_QUALITY_GATE=1"
        ]
      }
    }
  ],
  "notes": "TAN-7040. Strict profile: the same state refuses the commit (exit 2 routes like a permission deny, so the reason on stderr is what Claude reads). A broken build must not reach the history — and the message carries the escape, because a gate with no way out gets switched off wholesale."
}
