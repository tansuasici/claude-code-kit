{
  "name": "s56-compaction-keeps-failing-verdict",
  "steps": [
    {
      "hook": ".claude/hooks/quality-gate.sh",
      "setup_files": { "src/a.py": "def hello(\n    return 1\n" },
      "payload": { "tool_name": "Edit", "tool_input": { "file_path": "{TMPROOT}/src/a.py" } },
      "expect": { "exit_code": 0 }
    },
    {
      "hook": ".claude/hooks/session-start.sh",
      "payload": { "source": "compact", "session_id": "kitbench-s56" },
      "expect": {
        "exit_code": 0,
        "file_grew": [".hook-state/quality-gate-state.json", ".hook-state/last_quality_gate.json"]
      }
    },
    {
      "hook": ".claude/hooks/stop-gate.sh",
      "payload": {},
      "expect": { "exit_code": 2, "stderr_contains": ["BLOCKED", "src/a.py"] }
    }
  ],
  "notes": "A compaction mid-session re-runs session-start with source=compact. It must keep the per-file gate state, so a failing file still blocks the stop afterwards."
}
