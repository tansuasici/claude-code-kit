{
  "name": "s58-quality-gate-unsupported-file-unverified",
  "steps": [
    {
      "hook": ".claude/hooks/quality-gate.sh",
      "setup_files": { "src/a.py": "x = 1\n" },
      "payload": { "tool_name": "Edit", "tool_input": { "file_path": "{TMPROOT}/src/a.py" } },
      "expect": { "exit_code": 0 }
    },
    {
      "hook": ".claude/hooks/quality-gate.sh",
      "setup_files": { "src/app.rb": "puts 1\n" },
      "payload": { "tool_name": "Edit", "tool_input": { "file_path": "{TMPROOT}/src/app.rb" } },
      "expect": {
        "exit_code": 0,
        "stdout_contains": ["NOT verified", "app.rb"],
        "state": [
          { "file": ".hook-state/last_quality_gate.json", "field": "status", "equals": "passed" },
          { "file": ".hook-state/last_quality_gate.json", "field": "unverified_files", "equals": ["{TMPROOT}/src/app.rb"] }
        ]
      }
    },
    {
      "hook": ".claude/hooks/stop-gate.sh",
      "payload": {},
      "expect": { "exit_code": 0, "stderr_contains": ["without a passing check", "src/app.rb"] }
    }
  ],
  "notes": "No check exists for .rb. The gate used to exit silently, leaving the earlier .py pass standing — so the Ruby change looked verified. It is now recorded as skipped, Claude is told it is NOT verified, the summary lists exactly that file under unverified_files, and stop-gate names it without blocking."
}
